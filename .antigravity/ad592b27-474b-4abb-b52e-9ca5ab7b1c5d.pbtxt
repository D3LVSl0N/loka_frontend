    instruction: "Replace dark sidebar with light clean sidebar reflecting the LivestockGuard mockup"
    replacement_infos {
      original_chunk {
        target_content: "import { LayoutDashboard, Users, Shield, Settings, LogOut, Search, Bell } from \'lucide-react\';\n\nexport default function Sidebar() {\n  return (\n    <aside className=\"w-64 bg-slate-900 text-slate-300 flex flex-col h-full shrink-0\">\n      <div className=\"p-6 border-b border-slate-800 flex items-center gap-3\">\n        <div className=\"h-8 w-8 bg-blue-600 rounded-lg flex items-center justify-center\">\n          <Shield className=\"h-5 w-5 text-white\" />\n        </div>\n        <span className=\"text-lg font-bold text-white tracking-tight\">AdminPortal</span>\n      </div>\n\n      <nav className=\"flex-1 overflow-y-auto py-4 px-3 flex flex-col gap-1\">\n        <a href=\"#\" className=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\">\n          <LayoutDashboard className=\"h-5 w-5\" />\n          <span className=\"font-medium text-sm\">Dashboard</span>\n        </a>\n        <a href=\"#\" className=\"flex items-center gap-3 px-3 py-2.5 rounded-lg bg-blue-600/10 text-blue-400 font-medium transition-colors\">\n          <Users className=\"h-5 w-5\" />\n          <span className=\"font-medium text-sm\">User Management</span>\n        </a>\n        <a href=\"#\" className=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\">\n          <Settings className=\"h-5 w-5\" />\n          <span className=\"font-medium text-sm\">System Settings</span>\n        </a>\n      </nav>\n\n      <div className=\"p-4 border-t border-slate-800\">\n        <a href=\"#\" className=\"flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-slate-800 transition-colors\">\n          <LogOut className=\"h-5 w-5\" />\n          <span className=\"font-medium text-sm\">Sign Out</span>\n        </a>\n      </div>\n    </aside>\n  );\n}"
        replacement_content: "import { LayoutDashboard, Users, UserPlus, BarChart2, Settings, LogOut, ShieldCheck } from \'lucide-react\';\n\nexport type ViewType = \'dashboard\' | \'users\' | \'settings\';\n\ninterface SidebarProps {\n  currentView: ViewType;\n  onNavigate: (view: ViewType) => void;\n  onLogout: () => void;\n}\n\nexport default function Sidebar({ currentView, onNavigate, onLogout }: SidebarProps) {\n  const navItems = [\n    { id: \'dashboard\', label: \'Dashboard\', icon: LayoutDashboard },\n    { id: \'users\', label: \'Users Management\', icon: Users },\n    { id: \'add-user\', label: \'Add User (Simulated)\', icon: UserPlus }, // Visual only for demo\n    { id: \'reports\', label: \'Reports\', icon: BarChart2 }, // Visual only\n    { id: \'settings\', label: \'Settings\', icon: Settings },\n  ] as const;\n\n  return (\n    <aside className=\"w-64 bg-slate-50 border-r border-slate-200 flex flex-col h-full shrink-0 z-20\">\n      {/* Brand Header */}\n      <div className=\"p-6 border-b border-transparent flex items-center gap-3\">\n        <div className=\"h-9 w-9 bg-emerald-950 rounded-lg flex items-center justify-center shrink-0 shadow-sm\">\n          <ShieldCheck className=\"h-5 w-5 text-emerald-400\" />\n        </div>\n        <div>\n          <span className=\"text-[19px] font-black text-emerald-950 tracking-tight leading-none block font-sans\">LivestockGuard</span>\n          <span className=\"text-[11px] font-bold text-slate-500 block uppercase tracking-wider mt-0.5\">Enterprise Admin</span>\n        </div>\n      </div>\n\n      <nav className=\"flex-1 overflow-y-auto py-4 px-3 flex flex-col gap-1.5\">\n        {navItems.map((item) => {\n          const isActive = currentView === item.id;\n          const Icon = item.icon;\n          const isImplemented = [\'dashboard\', \'users\', \'settings\'].includes(item.id);\n          \n          return (\n            <button\n              key={item.id}\n              onClick={() => isImplemented && onNavigate(item.id as ViewType)}\n              className={`flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all w-full text-left\n                ${isActive \n                  ? \'bg-emerald-200/50 text-emerald-950 font-bold shadow-sm\' \n                  : \'text-slate-600 hover:bg-slate-200/50 hover:text-emerald-950 font-medium\'\n                }\n                ${!isImplemented ? \'opacity-40 cursor-not-allowed\' : \'\'}\n              `}\n            >\n              <Icon size={20} className={isActive ? \"text-emerald-800\" : \"text-slate-400\"} strokeWidth={isActive ? 2.5 : 2} />\n              <span className=\"text-sm\">{item.label}</span>\n            </button>\n          );\n        })}\n      </nav>\n\n      <div className=\"p-4 border-t border-slate-200 mt-auto\">\n        <button \n          onClick={onLogout}\n          className=\"w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-600 hover:text-red-700 hover:bg-red-50 transition-colors font-medium text-left\"\n        >\n          <LogOut size={20} className=\"text-slate-400\" />\n          <span className=\"text-sm\">Logout</span>\n        </button>\n      </div>\n    </aside>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
