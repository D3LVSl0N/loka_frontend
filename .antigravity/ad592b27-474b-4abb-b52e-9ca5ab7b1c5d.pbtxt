      replacement_content: "import { useState } from \'react\';\nimport Sidebar from \'./components/Sidebar\';\nimport UserTable from \'./components/UserTable\';\n\nexport default function App() {\n  const [currentUserRole, setCurrentUserRole] = useState<\'Admin\' | \'Superadmin\'>(\'Admin\');\n\n  return (\n    <div className=\"flex h-screen bg-slate-50 text-slate-900 font-sans antialiased overflow-hidden\">\n      {/* Isolated Sidebar */}\n      <Sidebar />\n      \n      {/* Main Content Area */}\n      <main className=\"flex-1 flex flex-col overflow-hidden\">\n        <header className=\"bg-white border-b border-slate-200 px-8 py-5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n          <div>\n            <h1 className=\"text-2xl font-semibold text-slate-800\">User Management</h1>\n            <p className=\"text-slate-500 text-sm mt-1\">Manage system administrators and operator access.</p>\n          </div>\n          \n          <div className=\"flex items-center gap-4 bg-slate-100 p-2 rounded-xl border border-slate-200\">\n            <span className=\"text-sm font-semibold text-slate-500 uppercase tracking-wider pl-2\">Live Preview As:</span>\n            <select \n              value={currentUserRole}\n              onChange={(e) => setCurrentUserRole(e.target.value as \'Admin\' | \'Superadmin\')}\n              className=\"bg-white border-slate-300 rounded-lg text-sm font-medium focus:ring-blue-500 focus:border-blue-500 text-slate-700 py-1.5 px-3 cursor-pointer shadow-sm\"\n              title=\"Toggle to see role-conditioned UI limits\"\n            >\n              <option value=\"Admin\">Admin</option>\n              <option value=\"Superadmin\">Superadmin</option>\n            </select>\n            <div className={`h-8 w-8 rounded-lg flex items-center justify-center text-white font-bold ml-2 shadow-sm ${currentUserRole === \'Superadmin\' ? \'bg-purple-600\' : \'bg-blue-600\'}`}>\n              {currentUserRole.charAt(